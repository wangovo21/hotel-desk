# 复制成 .env 后按需修改。所有值都有默认值，不配也能跑。
# 注意：已经存在的环境变量优先于本文件（见 app/config.py 的 load_dotenv）。

APP_ENV=dev

# 数据库文件位置，默认 backend/data/hotel.db
# DB_PATH=./data/hotel.db

# 管理口令：房型/房间/客人档案/参数这些"后台改配置"的写接口需要它。
# 前台日常动作（入住、续住、换房、加杂费、退房）**不需要**它 —— 理由见 README「权限边界」。
# 留空 = 后台写接口全部关闭并返回 ADMIN_TOKEN_NOT_CONFIGURED。
ADMIN_TOKEN=dev-admin-token

# 允许跨域的前端地址（dev 下 vite 跑在 5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 是否开启 /docs（离线也能开，Swagger UI 资源在 app/static/swagger 下）
DOCS_ENABLED=1
